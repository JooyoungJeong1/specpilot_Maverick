# .env.example 을 .env 로 복사한 뒤 키만 채운다. .env는 커밋하지 않는다.
ANTHROPIC_API_KEY=

# 아래는 바꿀 때만 앞의 # 을 지우고 값을 넣는다. 그대로 두면 기본값을 쓴다 (기본값은 specpilot/config.py)
# 모델 (기본 claude-sonnet-5)
# SPECPILOT_MODEL=
# ③ 화면별 파일 고르기에 쓸 모델. 비우면 SPECPILOT_MODEL (예: claude-haiku-5-5)
# SPECPILOT_SELECT_MODEL=
# 검사에 걸렸을 때 다시 요청하는 횟수 (기본 2)
# SPECPILOT_MAX_RETRIES=
# 응답 최대 토큰 (기본 32000)
# SPECPILOT_MAX_TOKENS=
# true면 화면 페이지만 자르지 않고 PDF 전체를 보낸다 (기본 false)
# SPECPILOT_FULL_PDF=
# ③에서 코드를 한 번에 보낼 토큰 한도 (기본 100000)
# SPECPILOT_CODE_TOKEN_LIMIT=
# 가격표에 없는 모델일 때 백만 토큰당 달러: 입력,출력,캐시쓰기,캐시읽기 (예: 2,10,2.5,0.2)
# SPECPILOT_PRICE=
